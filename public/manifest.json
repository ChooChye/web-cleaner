{
  "manifest_version": 3,
  "name": "Web Cleaner",
  "version": "1.0.0",
  "description": "Quickly clear browser data for the current website.",
  "permissions": [
    "browsingData",
    "tabs"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Web Cleaner",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
